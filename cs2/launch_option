sh -c 'xrandr --output DisplayPort-2 --mode 1920x1080 --rate 239.96 --scale-from 1280x960; "$@"; xrandr --output DisplayPort-2 --mode 1920x1080 --rate 239.96 --scale-from 1920x1080' -- %command%
